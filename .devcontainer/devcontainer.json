{
    "name": "bun",
    "dockerComposeFile": [
        "./compose.yaml"
    ],
    "service": "bun-devcontainer",
    "workspaceFolder": "/home/bun",
    "customizations": {
        "vscode": {
            "extensions": [
                // Linting for Javascript and TypeScript
                "dbaeumer.vscode-eslint",
                // Code formatting
                "esbenp.prettier-vscode",
                // Spell checking
                "streetsidesoftware.code-spell-checker",
                // Make typeScript errors human-readable
                "yoavbls.pretty-ts-errors"
            ]
        }
    },
    "shutdownAction": "stopCompose"
}